{
  "builds": [
    { "src": "main.py", "use": "@vercel/python" },
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "frontend/dist", "buildCommand": "npm install && npm run build" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/main.py" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
